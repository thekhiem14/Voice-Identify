# Public checkpoints normally work without a token. Set one if Hugging Face asks.
HF_TOKEN=

# Optional. The app auto-detects models/3D-Speaker and the legacy checkout.
SPEAKERLAB_ROOT=

# RTX/NVIDIA defaults. Use DEVICE=cpu and ASR_PROVIDER=cpu only as an explicit fallback.
DEVICE=cuda:0
ASR_PROVIDER=cuda
DIARIZATION_GPU_BATCH_SIZE=2
ASR_BATCH_SIZE=32
PROGRESS_LOG_EVERY=100

# Voice verification defaults to 0.40 in config/settings.py.
